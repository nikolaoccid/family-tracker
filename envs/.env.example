# Copy to envs/.env.local (or .env) and fill in. Never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Default matches `npm run db:up` (embedded Postgres on 127.0.0.1:54320). Or set DATABASE_HOST/PORT/USERNAME/PASSWORD/NAME.
DATABASE_URL=postgres://familytracker:familytracker@localhost:54320/familytracker
DATABASE_DISABLE_SSL=true

SESSION_SECRET=change-me-min-16-chars
JWT_SECRET=change-me-min-16-chars
JWT_MAIL_SECRET=change-me-min-16-chars

MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USER=mailer@example.com
MAIL_PASS=change-me
MAIL_FROM="Family Tracker <no-reply@example.com>"

STRIPE_SECRET_KEY=sk_test_replace_me
STREAM_API_KEY=replace-me
STREAM_API_SECRET=replace-me

# Comma-separated OAuth client ids (web, iOS, Android) accepted for Google sign-in. Empty disables it.
GOOGLE_CLIENT_IDS=

# Comma-separated browser origins allowed by CORS (mobile apps send no Origin header).
CORS_ORIGINS=http://localhost:8081
